# Kernel configuration fragment for the Zelda RISC-V emulator.
#
# Merged on top of arch/riscv/configs/rv32_defconfig. Two things matter here:
# the instruction set has to stay within what the emulator translates, and the
# driver list has to stay short - every driver that probes is boot time spent
# in a translator that runs a few million instructions per second.

# --- instruction set ---------------------------------------------------------
# The emulator implements rv32ima. Compressed instructions and floating point
# would both emit opcodes it cannot decode.
CONFIG_ARCH_RV32I=y
CONFIG_FPU=n
CONFIG_RISCV_ISA_C=n
CONFIG_RISCV_ISA_ZICBOM=n
CONFIG_RISCV_ISA_ZIHINTPAUSE=n

# --- platform ----------------------------------------------------------------
# One hart: the vmm executes a single hart today.
CONFIG_SMP=n
CONFIG_MMU=y
CONFIG_SOC_VIRT=y
CONFIG_SOC_SIFIVE=n
CONFIG_EFI=n
CONFIG_PCI=n
CONFIG_MODULES=n
CONFIG_KVM=n

# --- console -----------------------------------------------------------------
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_HVC_RISCV_SBI=n

# --- root filesystem ---------------------------------------------------------
# Userspace is built into the kernel image, so there is nothing to load.
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="../initramfs.list"
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# --- trim ---------------------------------------------------------------------
# None of this can be reached on this platform, and all of it costs boot time
# or image size.
CONFIG_NET=n
CONFIG_SCSI=n
CONFIG_BLK_DEV_MD=n
CONFIG_MD=n
CONFIG_USB_SUPPORT=n
CONFIG_SOUND=n
CONFIG_INPUT=n
CONFIG_HID=n
CONFIG_MMC=n
CONFIG_VIRTIO_MENU=n
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_HUGETLBFS=n
CONFIG_EXT4_FS=n
CONFIG_BTRFS_FS=n
CONFIG_F2FS_FS=n
CONFIG_XFS_FS=n
CONFIG_NFS_FS=n
CONFIG_CRYPTO_MANAGER=n
CONFIG_SUSPEND=n
CONFIG_PM=n
CONFIG_CPU_IDLE=n

CONFIG_DEBUG_INFO_NONE=y
CONFIG_PRINTK_TIME=y

# A lower tick rate means less of the emulated machine is spent servicing
# timers, which matters more here than timer resolution does.
CONFIG_HZ_100=y
CONFIG_HZ=100
